{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ssh-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "exports": {
    "TunnelRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNELS",
        "class_name": "TunnelRoom"
      }
    ]
  }
}
